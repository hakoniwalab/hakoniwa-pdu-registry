def py_to_cdr_body_{{ container.msg_type_name }}(writer: CdrWriter, src: {{ container.class_name }}):
{%- if not container.json_data["fields"] %}
    return
{%- endif %}
{%- for item in container.json_data["fields"] %}
{%-     if container.is_primitive(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(item["type"]) %}
    writer.write_{{ suffix|lower }}(src.{{ item["name"] }})
{%-     elif container.is_string(item["type"]) %}
    writer.write_string(src.{{ item["name"] }})
{%-     elif container.is_primitive_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_type = container.get_array_type(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(elem_type) %}
{%-         if array_size is none %}
    writer.write_sequence_length(src.{{ item["name"] }})
    for elem in src.{{ item["name"] }}:
        writer.write_{{ suffix|lower }}(elem)
{%-         else %}
    values = src.{{ item["name"] }}
    for i in range({{ array_size }}):
        writer.write_{{ suffix|lower }}(values[i] if i < len(values) else {{ container.get_python_default_value(elem_type) }})
{%-         endif %}
{%-     elif container.is_string_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         if array_size is none %}
    writer.write_sequence_length(src.{{ item["name"] }})
    for elem in src.{{ item["name"] }}:
        writer.write_string(elem)
{%-         else %}
    values = src.{{ item["name"] }}
    for i in range({{ array_size }}):
        writer.write_string(values[i] if i < len(values) else "")
{%-         endif %}
{%-     elif container.is_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_msg_type = container.get_msg_type(container.get_array_type(item["type"])) %}
{%-         if array_size is none %}
    writer.write_sequence_length(src.{{ item["name"] }})
    for elem in src.{{ item["name"] }}:
        py_to_cdr_body_{{ elem_msg_type }}(writer, elem)
{%-         else %}
    values = src.{{ item["name"] }}
    for i in range({{ array_size }}):
        py_to_cdr_body_{{ elem_msg_type }}(writer, values[i] if i < len(values) else {{ elem_msg_type }}())
{%-         endif %}
{%-     else %}
    py_to_cdr_body_{{ container.get_msg_type(item["type"]) }}(writer, src.{{ item["name"] }})
{%-     endif %}
{%- endfor %}


def cdr_body_to_py_{{ container.msg_type_name }}(reader: CdrReader, dst: {{ container.class_name }}):
{%- if not container.json_data["fields"] %}
    return dst
{%- endif %}
{%- for item in container.json_data["fields"] %}
{%-     if container.is_primitive(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(item["type"]) %}
    dst.{{ item["name"] }} = reader.read_{{ suffix|lower }}()
{%-     elif container.is_string(item["type"]) %}
    dst.{{ item["name"] }} = reader.read_string()
{%-     elif container.is_primitive_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_type = container.get_array_type(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(elem_type) %}
{%-         if array_size is none %}
    dst.{{ item["name"] }} = [reader.read_{{ suffix|lower }}() for _ in range(reader.read_uint32())]
{%-         else %}
    dst.{{ item["name"] }} = [reader.read_{{ suffix|lower }}() for _ in range({{ array_size }})]
{%-         endif %}
{%-     elif container.is_string_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         if array_size is none %}
    dst.{{ item["name"] }} = [reader.read_string() for _ in range(reader.read_uint32())]
{%-         else %}
    dst.{{ item["name"] }} = [reader.read_string() for _ in range({{ array_size }})]
{%-         endif %}
{%-     elif container.is_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_msg_type = container.get_msg_type(container.get_array_type(item["type"])) %}
{%-         if array_size is none %}
    dst.{{ item["name"] }} = []
    for _ in range(reader.read_uint32()):
        elem = {{ elem_msg_type }}()
        cdr_body_to_py_{{ elem_msg_type }}(reader, elem)
        dst.{{ item["name"] }}.append(elem)
{%-         else %}
    dst.{{ item["name"] }} = []
    for _ in range({{ array_size }}):
        elem = {{ elem_msg_type }}()
        cdr_body_to_py_{{ elem_msg_type }}(reader, elem)
        dst.{{ item["name"] }}.append(elem)
{%-         endif %}
{%-     else %}
    cdr_body_to_py_{{ container.get_msg_type(item["type"]) }}(reader, dst.{{ item["name"] }})
{%-     endif %}
{%- endfor %}
    return dst


def py_to_cdr_{{ container.msg_type_name }}(src: {{ container.class_name }}) -> bytes:
    writer = CdrWriter()
    writer.write_encapsulation()
    py_to_cdr_body_{{ container.msg_type_name }}(writer, src)
    return writer.bytes()


def cdr_to_py_{{ container.msg_type_name }}(cdr_payload) -> {{ container.class_name }}:
    reader = CdrReader(cdr_payload)
    reader.read_encapsulation()
    dst = {{ container.class_name }}()
    return cdr_body_to_py_{{ container.msg_type_name }}(reader, dst)
