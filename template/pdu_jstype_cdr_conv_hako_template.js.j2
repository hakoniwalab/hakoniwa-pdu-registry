import { {{ container.class_name }} } from './pdu_jstype_{{ container.msg_type_name }}.js';
import { PduCdrWriter, PduCdrReader } from '../pdu_cdr_runtime.js';
{% for item in container.js_imports -%}
import { {{ item.class_name }} } from '../{{ item.dep_pkg }}/pdu_jstype_{{ item.class_name }}.js';
import { Pdu{{ item.class_name }}Converter } from '../{{ item.dep_pkg }}/pdu_cdr_conv_{{ item.class_name }}.js';
{% endfor %}

export class Pdu{{ container.msg_type_name }}Converter {
    /**
     * @param {PduCdrWriter} writer
     * @param { {{ container.class_name }} } src
     */
    static to_cdr_body(writer, src) {
{%- if not container.json_data["fields"] %}
        return;
{%- endif %}
{%- for item in container.json_data["fields"] %}
{%-     if container.is_primitive(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(item["type"]) %}
        writer.write_{{ suffix|lower }}(src.{{ item["name"] }});
{%-     elif container.is_string(item["type"]) %}
        writer.write_string(src.{{ item["name"] }});
{%-     elif container.is_primitive_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_type = container.get_array_type(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(elem_type) %}
{%-         if array_size is none %}
        writer.write_sequence_length(src.{{ item["name"] }});
        for (const elem of src.{{ item["name"] }}) {
            writer.write_{{ suffix|lower }}(elem);
        }
{%-         else %}
        {
            const values = src.{{ item["name"] }};
            for (let i = 0; i < {{ array_size }}; i++) {
                writer.write_{{ suffix|lower }}(i < values.length ? values[i] : {{ container.get_js_default_value(elem_type) }});
            }
        }
{%-         endif %}
{%-     elif container.is_string_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         if array_size is none %}
        writer.write_sequence_length(src.{{ item["name"] }});
        for (const elem of src.{{ item["name"] }}) {
            writer.write_string(elem);
        }
{%-         else %}
        {
            const values = src.{{ item["name"] }};
            for (let i = 0; i < {{ array_size }}; i++) {
                writer.write_string(i < values.length ? values[i] : "");
            }
        }
{%-         endif %}
{%-     elif container.is_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_msg_type = container.get_msg_type(container.get_array_type(item["type"])) %}
{%-         if array_size is none %}
        writer.write_sequence_length(src.{{ item["name"] }});
        for (const elem of src.{{ item["name"] }}) {
            Pdu{{ elem_msg_type }}Converter.to_cdr_body(writer, elem);
        }
{%-         else %}
        {
            const values = src.{{ item["name"] }};
            for (let i = 0; i < {{ array_size }}; i++) {
                Pdu{{ elem_msg_type }}Converter.to_cdr_body(writer, i < values.length ? values[i] : new {{ elem_msg_type }}());
            }
        }
{%-         endif %}
{%-     else %}
        Pdu{{ container.get_msg_type(item["type"]) }}Converter.to_cdr_body(writer, src.{{ item["name"] }});
{%-     endif %}
{%- endfor %}
    }

    /**
     * @param {PduCdrReader} reader
     * @param { {{ container.class_name }} } dst
     * @returns { {{ container.class_name }} }
     */
    static cdr_body_to_js(reader, dst) {
{%- if not container.json_data["fields"] %}
        return dst;
{%- endif %}
{%- for item in container.json_data["fields"] %}
{%-     if container.is_primitive(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(item["type"]) %}
        dst.{{ item["name"] }} = reader.read_{{ suffix|lower }}();
{%-     elif container.is_string(item["type"]) %}
        dst.{{ item["name"] }} = reader.read_string();
{%-     elif container.is_primitive_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_type = container.get_array_type(item["type"]) %}
{%-         set suffix = container.get_python_cdr_suffix(elem_type) %}
{%-         if array_size is none %}
        dst.{{ item["name"] }} = Array.from({ length: reader.read_uint32() }, () => reader.read_{{ suffix|lower }}());
{%-         else %}
        dst.{{ item["name"] }} = Array.from({ length: {{ array_size }} }, () => reader.read_{{ suffix|lower }}());
{%-         endif %}
{%-     elif container.is_string_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         if array_size is none %}
        dst.{{ item["name"] }} = Array.from({ length: reader.read_uint32() }, () => reader.read_string());
{%-         else %}
        dst.{{ item["name"] }} = Array.from({ length: {{ array_size }} }, () => reader.read_string());
{%-         endif %}
{%-     elif container.is_array(item["type"]) %}
{%-         set array_size = container.get_array_size(item["name"], item["type"]) %}
{%-         set elem_msg_type = container.get_msg_type(container.get_array_type(item["type"])) %}
        dst.{{ item["name"] }} = [];
{%-         if array_size is none %}
        for (let i = 0, len = reader.read_uint32(); i < len; i++) {
            dst.{{ item["name"] }}.push(Pdu{{ elem_msg_type }}Converter.cdr_body_to_js(reader, new {{ elem_msg_type }}()));
        }
{%-         else %}
        for (let i = 0; i < {{ array_size }}; i++) {
            dst.{{ item["name"] }}.push(Pdu{{ elem_msg_type }}Converter.cdr_body_to_js(reader, new {{ elem_msg_type }}()));
        }
{%-         endif %}
{%-     else %}
        Pdu{{ container.get_msg_type(item["type"]) }}Converter.cdr_body_to_js(reader, dst.{{ item["name"] }});
{%-     endif %}
{%- endfor %}
        return dst;
    }

    /**
     * @param { {{ container.class_name }} } src
     * @returns {ArrayBuffer}
     */
    static to_cdr(src) {
        const writer = new PduCdrWriter();
        writer.write_encapsulation();
        this.to_cdr_body(writer, src);
        return writer.get_buf();
    }

    /**
     * @param {ArrayBuffer|ArrayBufferView} cdrPayload
     * @returns { {{ container.class_name }} }
     */
    static from_cdr(cdrPayload) {
        const reader = new PduCdrReader(cdrPayload);
        reader.read_encapsulation();
        return this.cdr_body_to_js(reader, new {{ container.class_name }}());
    }
}
